# ── AI Script Generation API Keys ──────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Hugging Face AI Image Generation (100% Free FLUX Visuals) ─────────────────
HF_TOKEN=your_huggingface_token_here
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# ── Sarvam AI Voiceover Settings ──────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_SPEAKER=ratan
SARVAM_MODEL=bulbul:v3

# ── Satisfying Video Stock API Keys (Optional) ────────────────────────────────
# (If blank, project uses local files from satisfying_clips/ or animated fallback background)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── Meta (Facebook & Instagram) API Credentials ──────────────────────────────
META_ACCESS_TOKEN=your_meta_page_access_token_here
META_IG_USER_ID=your_instagram_business_user_id_here
META_FB_PAGE_ID=your_facebook_page_id_here

# ── Cloudinary (For hosting Instagram Reel video files) ────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── AI Model Choice ───────────────────────────────────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-1.5-flash

# ── Edge-TTS Free Voice Fallback ──────────────────────────────────────────────
TTS_VOICE=hi-IN-SwaraNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz
TTS_VOLUME=+0%

# ── Automation & Execution Settings ──────────────────────────────────────────
DRY_RUN=false
POST_EVERY_HOURS=8

# ── Video Settings (9:16 Reels Format) ────────────────────────────────────────
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
VIDEO_BITRATE=8M
OUTPUT_DIR=output

